<?php

declare(strict_types=1);

/**
 * Invalidate the Twig template cache for Twig 3.x deprecation fixes.
 */
function ambientimpact_icon_update_10201(): void {

  \Drupal::service('twig')->invalidate();

}

/**
 * Rebuild libraries for RefreshLess preview icon loaded marking support.
 */
function ambientimpact_icon_update_10202(): void {

  \Drupal::service('library.discovery')->clearCachedDefinitions();

}

/**
 * Reset asset query string for addition of Bluesky icon and MDN icon update.
 */
function ambientimpact_icon_update_10203(): void {

  \Drupal::service('asset.query_string')->reset();

}
